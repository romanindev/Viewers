# Origin the OHIF viewer dev server runs on. Used both as the iframe src
# origin and for postMessage origin validation — never '*'.
VITE_VIEWER_ORIGIN=http://localhost:3000

# Direct study route inside the viewer (no OHIF study list).
VITE_VIEWER_STUDY_URL=http://localhost:3000/viewer?StudyInstanceUIDs=1.3.6.1.4.1.25403.345050719074.3824.20170125095438.5

# This host app's own origin. Used by the viewer bridge (PR 2) for its
# postMessage origin validation; recorded here so both sides agree on it.
VITE_HOST_ORIGIN=http://localhost:5173